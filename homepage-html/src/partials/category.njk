<section class="category-slider-section">
  <div class="category-header">
    <h2 class="category-title">Danh mục</h2>
    <div class="category-nav">
      <button class="cat-prev" aria-label="Previous">&lt;</button>
      <button class="cat-next" aria-label="Next">&gt;</button>
    </div>
  </div>
  <div class="category-slider">
    <div class="category-track">
      {% for category in categories %}
      <a href="{{ category.href }}" class="category-item">
        <div class="category-icon-wrap">
          <img src="../../assets/images/danhmuc/{{ category.icon }}" alt="{{ category.label }}">
        </div>
        <span class="category-name">{{ category.label }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
